# Copy to .env (or set these as environment variables on the server)
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=starbuild.example.ug
DJANGO_CSRF_TRUSTED_ORIGINS=https://starbuild.example.ug

# PostgreSQL (leave DB_NAME empty to use local SQLite for development)
DB_NAME=starbuild
DB_USER=starbuild
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# Purchase orders above this amount (UGX) need Director/Owner approval
PO_APPROVAL_THRESHOLD_UGX=5000000
